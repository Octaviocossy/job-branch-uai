GITHUB_TOKEN=""

# docker-compose.yml (see also apps/api/.env.example)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=api
POSTGRES_PORT=5432

API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api

# apps/web (Next.js) — browser-exposed API base URL (inlined into the client bundle at BUILD time)
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000