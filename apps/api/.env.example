NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api

# Integration/e2e tests use apps/api/.env.test (committed, non-secret) against the
# dedicated `postgres-test` compose service instead of these values:
# NODE_ENV=test
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/api_test
