{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:int": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:db": "pnpm test:int && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:test": "dotenv -e .env.test -- drizzle-kit studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v",
    "db:test:up": "docker compose up -d postgres-test",
    "db:test:down": "docker compose stop postgres-test",
    "db:test:migrate": "dotenv -e .env.test -- drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@repo/models": "workspace:*",
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@swc/core": "^1.15.43",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
